# AdLoop configuration
# Copy this file to ~/.adloop/config.yaml and fill in your values.
#
# Most users only need to set: customer_id (and login_customer_id with an MCC).
# The setup wizard (adloop init) handles everything automatically.
#
# See README.md for detailed setup instructions.

google:
  # Leave credentials_path empty to use AdLoop's built-in OAuth credentials.
  # Only set this if you're using your own Google Cloud project or a service account.
  # credentials_path: "~/.adloop/credentials.json"

  # OAuth token is stored here automatically after first login.
  # You shouldn't need to touch this.
  token_path: "~/.adloop/token.json"

ga4:
  # Your GA4 property ID (numeric).
  # Find it in GA4 → Admin → Property Settings.
  # The setup wizard auto-discovers this after OAuth.
  property_id: ""

ads:
  # Google Ads API access belongs to the Google Cloud project that owns your
  # OAuth client (developer tokens were sunset in September 2026). Apply on
  # the project's Google Ads API Overview page in the Cloud Console:
  # Explorer (granted automatically) gives 2,880 operations/day, Basic
  # 15,000/day. Leave the legacy token empty; it is ignored by the API.
  developer_token: ""

  # Default Google Ads customer ID (e.g. "123-456-7890").
  # This is the account you want to manage, not the MCC.
  # The setup wizard auto-discovers this after OAuth.
  customer_id: ""

  # Your MCC (Manager) account ID (e.g. "123-456-7890").
  # Required for API access — even if you only manage one account.
  login_customer_id: ""

gsc:
  # Your Google Search Console site URL.
  # Use the exact URL shown in the GSC property selector, e.g.:
  #   "https://example.com/"         (URL-prefix property)
  #   "sc-domain:example.com"        (Domain property)
  # Leave empty to pass site_url as a parameter in each tool call instead.
  site_url: ""

gtm:
  # Default Google Tag Manager account + container for the GTM tools.
  # Find both via list_gtm_accounts / list_gtm_containers, or in the GTM UI
  # under Admin -> Container Settings. Leave empty to pass
  # gtm_account_id / gtm_container_id as parameters in each call instead.
  account_id: ""
  container_id: ""
  # GTM write tools (draft_gtm_tag / draft_gtm_trigger / draft_delete_gtm_entity
  # / draft_publish_gtm_workspace / draft_rollback_gtm_version). Off by default. Turning it on adds the
  # Tag Manager edit + publish scopes to the OAuth grant — you'll be asked to
  # re-consent once. Turning it back off does not revoke an existing grant;
  # delete ~/.adloop/token.json for that.
  write_enabled: false
  # Custom HTML tags execute arbitrary JavaScript on your site. Even with
  # write_enabled, AdLoop refuses to create/edit them, or publish a workspace
  # that adds/changes one, unless this is also true.
  allow_custom_html: false

merchant:
  # Default Google Merchant Center account for get_merchant_feed_health.
  # The numeric ID from list_merchant_accounts, or from the Merchant Center
  # UI (top-right corner / in the URL). Leave empty to pass account_id as a
  # parameter in each call instead.
  account_id: ""

pagespeed:
  # Optional Google API key for PageSpeed Insights (analyze_page_speed).
  # Works without one at very low rates; create a key in your GCP project
  # (APIs & Services -> Credentials) and enable "PageSpeed Insights API"
  # for a stable quota. No OAuth involved.
  api_key: ""

reddit:
  # Reddit Ads (optional). Reddit is a separate OAuth provider with its own
  # developer app: Reddit Ads Manager -> Business Manager -> Developer
  # Application -> Create app. Register the redirect URL exactly as
  # http://localhost:8765/callback, then run `adloop init` and complete the
  # Reddit Ads step; it writes the token file below. No approval process,
  # no developer token. Rate limits are per Reddit user, not per app.
  client_id: ""
  client_secret: ""
  # Default ad account for every Reddit tool (find it via list_reddit_accounts).
  ad_account_id: ""
  # Your Reddit username; only used to build the descriptive User-Agent that
  # Reddit requires ("platform:app:version (by /u/name)").
  username: ""
  # Override the whole User-Agent string if you prefer.
  user_agent: ""
  token_path: "~/.adloop/reddit_token.json"

microsoft_ads:
  # Microsoft Advertising / Bing (optional, REST API v13). Needs:
  # 1. A developer token: Microsoft Advertising -> Settings -> Developer
  #    settings, or https://developers.ads.microsoft.com/Account.
  # 2. An Entra app registered with "Allow public client flows" on and the
  #    Microsoft Advertising API permission msads.manage. Its application id:
  # 3. `adloop microsoft-login` once: the browser opens, sign in with the
  #    account that has access to the ad accounts; the refresh token lands in
  #    token_path. The app needs http://localhost/callback as a
  #    mobile/desktop redirect URI (the sign-in listens on a free port; Entra
  #    ignores the port of localhost redirects). (--device-code is a fallback;
  #    directories with security defaults block it with error 530035.)
  #    Users who sign in to Microsoft Advertising with Google are not
  #    supported yet: invite a Microsoft account or work (Entra) user to the
  #    ad account and sign in as that user.
  developer_token: ""
  client_id: ""
  client_secret: ""   # only for confidential (web) apps
  tenant: "common"
  # Manager account (CustomerId) and default ad account (CustomerAccountId);
  # list_microsoft_ads_accounts shows both.
  customer_id: ""
  ad_account_id: ""
  token_path: "~/.adloop/microsoft_token.json"

chatgpt_ads:
  # ChatGPT Ads (optional, OpenAI Advertiser API). Create a key in OpenAI Ads
  # Manager -> Settings -> API keys (https://ads.openai.com/settings). It is an
  # Ads key, not a platform.openai.com key. Each key belongs to exactly one ad
  # account. Leave blank to read OPENAI_ADS_API_KEY from the environment.
  api_key: ""
  # Optional: the default key's ad account id (adacct_...). When set, a tool
  # call for another account id is refused instead of reading this one.
  ad_account_id: ""
  # More ad accounts (agencies): one key per account id. A tool's
  # ad_account_id picks the key.
  accounts: {}

safety:
  # Maximum daily budget allowed per campaign (in your account's currency).
  # AdLoop will reject any campaign creation or budget change above this.
  max_daily_budget: 50.00

  # Maximum percentage a bid can increase in a single operation.
  max_bid_increase_pct: 100

  # Force all write operations to dry-run mode.
  # Set to false only when you're ready to make real changes.
  require_dry_run: true

  # Two-phase apply: confirm_and_apply refuses dry_run=false for any plan
  # that has not completed a dry-run pass first. Enforces the order
  # (preview, then apply) without blocking real writes entirely.
  two_phase_apply: false

  # Approval cards. AI apps that support MCP Apps (Claude, ChatGPT, VS Code)
  # show every change preview as a card with "Test run" and "Apply" buttons,
  # and then only that click applies a change: the AI cannot apply it by
  # itself. Set to true to also accept "yes, apply it" in the chat, for an
  # app that claims card support but does not show the card. Apps without
  # cards that support confirmation dialogs (elicitation) ask you in a dialog
  # before a real apply instead; true skips that dialog too. Apps with
  # neither use the chat flow.
  allow_chat_approval: false

  # Path to the audit log file. All operations are logged here.
  log_file: "~/.adloop/audit.log"

  # List of operations to block entirely (e.g. ["remove_entity"]).
  blocked_operations: []

# Views (experimental). In AI apps that support MCP Apps (Claude, ChatGPT,
# VS Code), read results such as campaign performance also appear as an
# interactive dashboard: headline numbers, what needs attention, spend per
# campaign and a sortable table. The answer the AI reads stays the same.
# Needs the optional package: pip install "adloop[views]". Restart the MCP
# server and reconnect the app after switching it, since apps keep the tool
# list from when they connected.
views:
  enabled: false
